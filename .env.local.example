# Supabase Auth (login/session management)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Postgres connection string (for Prisma)
# Get from: Supabase Dashboard → Settings → Database → Connection string → URI (Session pooler)
DATABASE_URL=postgresql://postgres.[your-ref]:[your-password]@aws-0-xx-xx-x.pooler.supabase.com:5432/postgres

# Supabase Service Role Key (for auto-creating admin user — NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Admin credentials for /ax-portal
ADMIN_EMAIL=admin@axentiaai.com
ADMIN_PASSWORD=your-admin-password

# SMTP (contact form confirmation emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_NAME=Axentia.AI
SMTP_FROM_EMAIL=your-email@gmail.com
